{
  "vault": "~/FontFamilyVault",
  "device_id": "replace-with-stable-device-id",
  "device_name": "My Design Machine",
  "interval_seconds": 30,
  "publish_roots": [
    "~/Library/Fonts"
  ],
  "installed_roots": [
    "~/Library/Fonts",
    "/Library/Fonts",
    "/System/Library/Fonts"
  ],
  "install_root": "~/Library/Fonts",
  "ignore_patterns": [
    ".*",
    "__MACOSX",
    "*.download",
    "*.tmp",
    "*.bak"
  ],
  "refresh_font_cache": false
}
